# Статический ключ для заголовка X-API-Key
AUTH_API_KEY=change-me

LOGS_IS_JSON=False
LOGS_LEVEL=INFO

# Значения для запуска приложения на хосте; в docker-compose host/port переопределяются
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=payments
RABBITMQ_PASSWORD=payments

API_PORT=8000

# Необязательные настройки (ниже — значения по умолчанию)
# OUTBOX_POLL_INTERVAL=0.5
# OUTBOX_BATCH_SIZE=100
# CONSUMER_MAX_ATTEMPTS=3
# CONSUMER_RETRY_BASE_DELAY=2.0
# CONSUMER_PREFETCH_COUNT=10
